{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Savehorse",
  "version": "0.3.1",
  "identifier": "com.drsamonline.savehorse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Savehorse",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "publisher": "Dr Sohil Momin",
    "copyright": "\u00a9 2026 Dr Sohil Momin. PolyForm Noncommercial 1.0.0.",
    "category": "Utility",
    "shortDescription": "One bench, thirteen tools.",
    "longDescription": "savehorse folds twenty-two small Windows utilities into thirteen modules behind one desktop app: vault and security, binary lab, disc images, images, archives, text search, documents, filesystem, rename, system, window management, recovery and audio.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}